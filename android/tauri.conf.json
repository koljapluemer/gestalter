{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestalter",
  "version": "0.1.0",
  "identifier": "com.koljasam.gestalter",
  "build": {
    "frontendDist": "../distribution-android/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../distribution-android" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../distribution-android" }
  },
  "app": {
    "windows": [{ "title": "Gestalter" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
